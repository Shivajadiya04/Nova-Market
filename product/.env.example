# ---------- Runtime ----------
NODE_ENV=development
# true  = in-memory development data; RabbitMQ is stubbed when RABBIT_URL is empty and uploaded
#         images are stored inline when IMAGEKIT_PRIVATE_KEY is empty.
#         Refused unless NODE_ENV is development or test.
USE_MOCK_DB=true
PORT=3001

# ---------- Always required ----------
# Same value as every other service
JWT_SECRET=
# Same value as auth/order/payment/gateway (the order service reserves stock through /internal)
INTERNAL_SERVICE_TOKEN=

# ---------- Required when USE_MOCK_DB=false ----------
MONGO_URI=
RABBIT_URL=
# ImageKit (product images). From https://imagekit.io/dashboard/developer/api-keys
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
