# ---------- Runtime ----------
NODE_ENV=development
# true = in-memory development data; RabbitMQ is stubbed when RABBIT_URL is empty.
#        Refused unless NODE_ENV is development or test.
USE_MOCK_DB=true
PORT=3003

# ---------- Always required ----------
# Same value as every other service
JWT_SECRET=
# Same value as auth/product/payment/gateway
INTERNAL_SERVICE_TOKEN=
# Base URLs (full URL or host:port, no /api) used to read the cart and prices and reserve stock
CART_SERVICE_URL=http://localhost:3002
PRODUCT_SERVICE_URL=http://localhost:3001

# ---------- Required when USE_MOCK_DB=false ----------
MONGO_URI=
RABBIT_URL=
