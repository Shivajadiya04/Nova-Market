# ---------- Runtime ----------
NODE_ENV=development
# true  = in-memory MongoDB with sample data; RabbitMQ and Redis are stubbed when their settings are empty.
#         Refused unless NODE_ENV is development or test.
# false = real MongoDB/RabbitMQ/Redis (the values below become required).
USE_MOCK_DB=true

# Port to listen on (hosting platforms set this automatically)
PORT=3000

# ---------- Always required ----------
# Must be the SAME value in every service: auth signs the JWT, the others verify it.
# At least 32 characters in production.
JWT_SECRET=
# Shared secret for service-to-service calls (/internal/* endpoints). Same value in
# auth, product, order, payment and gateway. At least 32 characters in production.
INTERNAL_SERVICE_TOKEN=

# ---------- Required when USE_MOCK_DB=false ----------
# e.g. mongodb+srv://<user>:<password>@<cluster>/auth?retryWrites=true&w=majority
MONGO_URI=
# e.g. amqps://<user>:<password>@<host>/<vhost> (CloudAMQP) or amqp://guest:guest@localhost:5672
RABBIT_URL=
# Redis stores revoked tokens (server-side logout). Either a URL (redis:// or rediss:// for TLS)...
REDIS_URL=
# ...or host/port/password
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
