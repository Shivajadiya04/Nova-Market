# Gateway: the only public service. Serves frontend/dist and proxies /api/* to the services.
NODE_ENV=development

# Shared with auth/product/order/payment (internal service-to-service authentication)
INTERNAL_SERVICE_TOKEN=

# Backend base URLs (full URL or host:port). Local defaults:
AUTH_SERVICE_URL=http://localhost:3000
PRODUCT_SERVICE_URL=http://localhost:3001
CART_SERVICE_URL=http://localhost:3002
ORDER_SERVICE_URL=http://localhost:3003
PAYMENT_SERVICE_URL=http://localhost:3004
SELLER_DASHBOARD_SERVICE_URL=http://localhost:3007
# Optional: the AI assistant is disabled (503) when empty
AI_BUDDY_SERVICE_URL=

# Optional: where the built frontend lives (default ../frontend/dist)
FRONTEND_DIST=
