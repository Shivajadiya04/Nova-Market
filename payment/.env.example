# ---------- Runtime ----------
NODE_ENV=development
# true = in-memory development data; RabbitMQ is stubbed when RABBIT_URL is empty and a local
#        Razorpay stand-in is used when RAZORPAY_KEY_ID is empty. Refused unless NODE_ENV is development or test.
USE_MOCK_DB=true
PORT=3004

# ---------- Always required ----------
# Same value as every other service
JWT_SECRET=
# Same value as auth/product/order/gateway (used to confirm paid orders)
INTERNAL_SERVICE_TOKEN=
# Base URL (full URL or host:port, no /api) of the order service
ORDER_SERVICE_URL=http://localhost:3003

# ---------- Required when USE_MOCK_DB=false ----------
MONGO_URI=
RABBIT_URL=
# From https://dashboard.razorpay.com -> Account & Settings -> API Keys (rzp_test_... for testing)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---------- Strongly recommended in production ----------
# Secret you choose when adding the webhook https://<your-site>/api/payments/webhook/razorpay
# (events: payment.captured, payment.failed). Confirms orders even if the customer closes the browser.
RAZORPAY_WEBHOOK_SECRET=
