# Notification service: consumes RabbitMQ events and sends email through Gmail (OAuth2).
# It has no mock mode and is not needed for local mock development.
PORT=3006

RABBIT_URL=

# Gmail OAuth2 credentials: create an OAuth client in Google Cloud Console (Gmail API enabled),
# then get a refresh token for EMAIL_USER, e.g. via https://developers.google.com/oauthplayground
EMAIL_USER=
CLIENT_ID=
CLIENT_SECRET=
REFRESH_TOKEN=
# Sender display name
EMAIL_FROM_NAME=Nova Market
