# AI Buddy: Socket.IO chat assistant backed by Google Gemini. It has no mock mode;
# it needs a real Gemini key and is optional for local mock development.
PORT=3005

# Same value as every other service (used to verify the login cookie)
JWT_SECRET=

# From https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
# Gemini model name; change it if Google retires the default
GEMINI_MODEL=gemini-2.0-flash

# Base URLs the assistant's tools call (full URL or host:port, no /api)
PRODUCT_SERVICE_URL=http://localhost:3001
CART_SERVICE_URL=http://localhost:3002
