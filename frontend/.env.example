# ---------- Exposed to the browser (VITE_ prefix) - never put secrets here ----------
# Base path of the backend API. Keep "/api": the gateway serves the app and the API from the
# same origin in production, and the Vite dev server proxies /api to the gateway locally.
VITE_API_BASE_URL=/api

# ---------- Dev/preview proxy target (read by vite.config.js only, not bundled) ----------
GATEWAY_URL=http://localhost:8080
