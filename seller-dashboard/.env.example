# ---------- Runtime ----------
NODE_ENV=development
# true = in-memory development data seeded with sample users/products/orders/payments (in real
#        mode this data arrives via RabbitMQ events). Refused unless NODE_ENV is development or test.
USE_MOCK_DB=true
PORT=3007

# ---------- Always required ----------
# Same value as every other service
JWT_SECRET=

# ---------- Required when USE_MOCK_DB=false ----------
MONGO_URI=
RABBIT_URL=

# ---------- Optional ----------
# Products at or below this stock are listed as "low stock" on the dashboard
LOW_STOCK_THRESHOLD=5
